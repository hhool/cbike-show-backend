# 童车评测实验室 — 本地开发环境变量
# 复制本文件为 .env.local 并填入实际值

# Payload 加密密钥(任意 32+ 字符字符串)
PAYLOAD_SECRET=please-change-me-to-32-chars-secret

# Media 元数据灰度开关(默认关闭；开启后恢复 storage 字段与 hooks)
MEDIA_STORAGE_METADATA_ROLLOUT=false

# 数据库:本地默认 SQLite(file:./payload.db);生产可换 Postgres 连接串
DATABASE_URL=file:./payload.db

# 站点 URL(用于 livePreview / 前端回链)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP(可选,用于会员邮箱验证码)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@cbike-lab.example
# SMTP_FROM_NAME=Cbike Review Lab
