# Production environment template for site_cbike_show
# Copy values into your hosting platform (Render/Vercel), do not commit secrets.

NODE_ENV=production
RENDER=true

# Core security
PAYLOAD_SECRET=replace-with-strong-random-string
NEXTAUTH_SECRET=replace-with-strong-random-string

# URLs
NEXTAUTH_URL=https://<your-render-domain>
NEXT_PUBLIC_SITE_URL=https://<your-render-domain>
NEXT_PUBLIC_API_BASE_URL=https://<your-render-domain>
PROTOTYPE_SITE_URL=https://cbike-show-front.vercel.app
CORS_ORIGINS=https://cbike-show-front.vercel.app

# Database (Neon Postgres recommended)
# Accepts either `postgres://` or `postgresql://`
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require

# Optional seed overrides
SEED_ADMIN_EMAIL=admin@cbike-lab.example
SEED_ADMIN_PASSWORD=Admin@2026!

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@cbike-lab.example
SMTP_FROM_NAME=Cbike Review Lab

# Optional object storage (if integrated)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=