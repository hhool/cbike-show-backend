# Production environment template for site_cbike_show
# For Vercel deployment - copy values into Vercel Environment Variables, do not commit secrets.

NODE_ENV=production
VERCEL=true
RENDER=false

# Core security (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=replace-with-strong-random-string-32chars
NEXTAUTH_SECRET=replace-with-strong-random-string-32chars
AUTH_SECRET=replace-with-strong-random-string-32chars

# Media 元数据灰度开关(默认关闭；仅在迁移确认后开启)
MEDIA_STORAGE_METADATA_ROLLOUT=false

# URLs (replace with your actual Vercel domain)
NEXTAUTH_URL=https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://your-project.vercel.app
PROTOTYPE_SITE_URL=https://cbike-show-front.vercel.app
CORS_ORIGINS=https://cbike-show-front.vercel.app,https://your-project.vercel.app

# Database (Neon PostgreSQL recommended)
# Format: postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/neondb?sslmode=verify-full&channel_binding=require

# Seed data (optional)
SEED_ADMIN_EMAIL=admin@cbike-lab.example
SEED_ADMIN_PASSWORD=replace-with-strong-random-password

# SMTP (Resend recommended for free tier)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM_ADDRESS=noreply@cbike-lab.example
SMTP_FROM_NAME=Cbike Review Lab
SMTP_SECURE=false

# File Storage (Cloudflare R2 - recommended, free 10GB)
# If R2 variables are not set, media upload is disabled on Vercel by design.
R2_ACCOUNT_ID=b40383bf3afb30ccc7c9a13d6c9b6868
R2_REGION=auto
R2_BUCKET_NAME=cbike-media
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_ENDPOINT=https://b40383bf3afb30ccc7c9a13d6c9b6868.r2.cloudflarestorage.com

# Alternative: AWS S3 (if preferred)
# S3_BUCKET=cbike-media-production
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key